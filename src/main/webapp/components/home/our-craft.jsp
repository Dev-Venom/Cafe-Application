<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<section class="our-craft">

    <div class="container">

        <div class="craft-grid">

            <!-- LEFT -->

            <div class="craft-content">

                <span class="section-tag">
                    OUR CRAFT
                </span>

                <h2>
                    From Bean<br>
                    to Cup
                </h2>

                <p>
                    Every cup at Pour d'Or is prepared through a
                    carefully refined process, ensuring consistency,
                    freshness, and exceptional flavour in every sip.
                </p>

                <div class="craft-steps">

                    <div class="craft-step">
                        <span>01</span>
                        <h3>Select Premium Beans</h3>
                    </div>

                    <div class="craft-step">
                        <span>02</span>
                        <h3>Roast in Small Batches</h3>
                    </div>

                    <div class="craft-step">
                        <span>03</span>
                        <h3>Brew with Precision</h3>
                    </div>

                    <div class="craft-step">
                        <span>04</span>
                        <h3>Serve Fresh Every Time</h3>
                    </div>

                </div>

            </div>

            <!-- RIGHT -->

            <div class="craft-image">

                <img
                    src="${pageContext.request.contextPath}/assets/images/people/barista.jpg"
                    alt="Barista preparing coffee">

            </div>

        </div>

    </div>

</section>