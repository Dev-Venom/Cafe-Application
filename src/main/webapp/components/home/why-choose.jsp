<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<section class="why-choose">

    <div class="container">

        <div class="section-heading">

            <span class="section-tag">
                WHY POUR D'OR
            </span>

            <h2>
                More than coffee.<br>
                An experience.
            </h2>

        </div>

        <div class="feature-grid">

            <div class="feature-card">
                <div class="feature-icon">
    <img src="${pageContext.request.contextPath}/assets/icons/coffee.svg"
         alt="Fresh Coffee">
</div>
                <h3>Freshly Roasted</h3>
                <p>
                    Small-batch roasted beans for maximum freshness and flavor.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">👨‍🍳</div>
                <h3>Expert Baristas</h3>
                <p>
                    Every cup is handcrafted by trained coffee specialists.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🌱</div>
                <h3>Premium Beans</h3>
                <p>
                    Carefully sourced Arabica beans from trusted growers.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🏡</div>
                <h3>Warm Ambience</h3>
                <p>
                    Designed for conversations, work, and unforgettable moments.
                </p>
            </div>

        </div>

    </div>

</section>