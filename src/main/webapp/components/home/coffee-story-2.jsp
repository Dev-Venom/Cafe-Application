<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<section class="coffee-story">

    <div class="container">

        <div class="story-grid reverse">

            <!-- LEFT -->
            <div class="story-image reveal fade-left">

                <img
                    src="${pageContext.request.contextPath}/assets/images/story/latte.jpg"
                    alt="Velvet Latte">

            </div>

            <!-- RIGHT -->
            <div class="story-content reveal fade-right">

                <div class="story-number">
                    02
                </div>

                <span class="section-tag">
                    Artisan Creations
                </span>

                <h2>Velvet Latte</h2>

                <h3>Silky. Smooth. Comforting.</h3>

                <p>
                    Crafted with freshly brewed espresso and perfectly
                    steamed milk, our Velvet Latte delivers a rich,
                    creamy texture with delicate latte art that turns
                    every cup into a comforting masterpiece.
                </p>

                <a href="${pageContext.request.contextPath}/menu"
                   class="btn btn-primary">
                    View Menu
                </a>

            </div>

        </div>

    </div>

</section>