<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<section class="coffee-story">

    <div class="container">

        <div class="story-grid reverse">

            <!-- LEFT IMAGE -->

            <div class="story-image">

                <img
                    src="${pageContext.request.contextPath}/assets/images/story/latte.jpg"
                    alt="Velvet Latte">

            </div>

            <!-- RIGHT CONTENT -->

            <div class="story-content">

                <div class="story-number">
                    02
                </div>

                <span class="section-tag">
                    OUR CRAFT
                </span>

                <h2>
                    Velvet Latte
                </h2>

                <h3>
                    Smooth. Creamy. Comforting.
                </h3>

                <p>
                    Steamed milk meets our signature espresso,
                    creating a perfectly balanced cup with silky
                    texture and naturally sweet notes.
                </p>

                <a href="#" class="btn btn-primary">
                    Discover More
                </a>

            </div>

        </div>

    </div>

</section>