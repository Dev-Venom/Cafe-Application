<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<section class="coffee-story">

    <div class="container">

        <div class="story-grid">

            <!-- LEFT -->
            <div class="story-content reveal fade-left">

                <div class="story-number">
                    01
                </div>

                <span class="section-tag">
                    Signature Collection
                </span>

                <h2>Classic Espresso</h2>

                <h3>Rich. Bold. Timeless.</h3>

                <p>
                    Every espresso begins with carefully selected
                    Arabica beans, roasted to perfection and brewed
                    by our experienced baristas to create an
                    unforgettable coffee experience.
                </p>

                <a href="#" class="btn btn-primary">
                    Explore Menu
                </a>

            </div>

            <!-- RIGHT -->
            <div class="story-image reveal fade-right">

                <img
                    src="${pageContext.request.contextPath}/assets/images/story/espresso.jpg"
                    alt="Classic Espresso">

            </div>

        </div>

    </div>

</section>