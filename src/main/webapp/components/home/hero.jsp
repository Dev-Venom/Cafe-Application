<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<section class="hero">

    <div class="container hero-container">
    
    <div class="hero-content reveal fade-left">

        

            <span class="hero-badge">
                Premium Coffee Experience
            </span>

            <h1 class="display-xl">
                Crafted Coffee.<br>
                Extraordinary Moments.
            </h1>

            <p>
                Experience handcrafted coffee made from carefully selected beans,
                brewed with passion, and served in a warm atmosphere designed
                for meaningful conversations.
            </p>

            <div class="hero-buttons">

                <a href="${pageContext.request.contextPath}/menu" class="btn btn-primary">
                    Explore Menu
                </a>

                <a href="#" class="btn btn-outline">
                    Our Story
                </a>

            </div>

        </div>

        <div class="hero-image reveal fade-right">

            <img
                src= "assets/images/hero/hero-coffee.jpg"
                alt="Pour d'Or Coffee">

        </div>

    </div>

</section>
</body>
</html>