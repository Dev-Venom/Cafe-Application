<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<article class="card">

    <div class="card-image">

        <img src="assets/images/coffee/espresso.jpg"
             alt="Coffee">

        <span class="coffee-badge">

            Best Seller

        </span>

    </div>

    <div class="card-body">

        <div class="card-rating">

            ★★★★★

            <span>4.9</span>

        </div>

        <h3 class="card-title">

            Classic Espresso

        </h3>

        <p class="card-description">

            Rich aroma with handcrafted perfection.

        </p>

        <div class="card-footer">

            <span class="card-price">

                ₹249

            </span>

            <a href="#"
               class="btn btn-primary btn-sm">

                Add to Cart

            </a>

        </div>

    </div>

</article>
</body>
</html>